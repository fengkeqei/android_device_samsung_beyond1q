# beyond1q: stock sda27 occupies /product and shadows LOS product content
# (RRO overlays, ModuleMetadata, lineage feature XMLs). Bind-mount the merged
# /system/product over it so the framework's OverlayManager sees all overlays.
on post-fs-data
    # wpa_supplicant HAL (AIDL) needs its /data config dir; stock layout used
    # /data/misc/wifi so these don't exist until supplicant creates conf.
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    # stock vendor build.prop (not regenerated by LOS) carried the RIL libpath;
    # without it rild runs library-less and no IRadio ever registers.
    # NOTE: stock Samsung rild reads vendor.sec.rild.libpath (not vendor.rild.libpath);
    # without the sec variant it sits in libsec-ril's "RIL_Init sleep loop" forever.
    setprop vendor.rild.libpath /vendor/lib64/libsec-ril.so
    setprop vendor.sec.rild.libpath /vendor/lib64/libsec-ril.so
    setprop rild.libpath /vendor/lib64/libsec-ril.so
    # AMS PROC_START_TIMEOUT = 10s * ro.hw_timeout_multiplier (Build.java);
    # DSDS dual-RIL construction needs >10s -> 3x window. Must land before zygote.
    setprop ro.hw_timeout_multiplier 3
    # AudioFlinger standby 3s -> 30s: sec_primary HAL resume from standby costs
    # 0.5-1.1s per playback (Start latency measured). 30s keeps thread hot.
    setprop ro.audio.flinger_standbytime_ms 30000
    # Round 50b: QTI BT audio HAL (audio.bluetooth_qti) refuses to register its
    # HIDL IBluetoothAudioProvidersFactory unless the build claims QC value-adds
    # (libqti_vndfwk_detect reads these). Offload cap flag for the BT stack.
    setprop ro.vendor.qti.va_odm.support true
    setprop ro.vendor.qti.va_aosp.support true
    setprop ro.bluetooth.a2dp_offload.supported true
    setprop persist.bluetooth.a2dp_offload.disabled false
    # Round 50: BCM4375 is Broadcom (not BOARD_HAVE_BLUETOOTH_QCOM) so the qcom
    # bt profile property block never applied; BluetoothProperties default orElse(false)
    # disabled every classic profile (A2DP/AVRCP/HFP) -> paired headsets unusable.
    setprop bluetooth.profile.a2dp.source.enabled true
    setprop bluetooth.profile.avrcp.target.enabled true
    setprop bluetooth.profile.avrcp.controller.enabled true
    setprop bluetooth.profile.hfp.ag.enabled true
    setprop bluetooth.profile.hfp.client.enabled true
    setprop bluetooth.profile.gatt.enabled true
    setprop bluetooth.profile.hid.host.enabled true
    setprop bluetooth.profile.hid.device.enabled false
    setprop bluetooth.profile.map.server.enabled true
    setprop bluetooth.profile.opp.enabled true
    setprop bluetooth.profile.pan.nap.enabled true
    setprop bluetooth.profile.pan.panu.enabled true
    setprop bluetooth.profile.pbap.server.enabled true
    setprop bluetooth.profile.bas.client.enabled true
    setprop bluetooth.device_id.vendor_id 0x001D
    write /dev/kmsg "B1Q: product bind-mount starting\n"
    mount none /system/product /product bind rec
    write /dev/kmsg "B1Q: product bind-mount rc=${?}\n"

# OverlayManager does not persist the gestural overlay enabled-state across
# reboots on this device; re-apply after boot so gesture nav comes up.
# NOTE: seclabel u:r:su:s0 exists via KernelSU; a clean enforcing ROM needs a
# proper sepolicy domain (network context ioctls) for this service.
service wifi_pm_fix /system/bin/sh /vendor/bin/wifi_pm_fix.sh
    class late_start
    user root
    group root wifi inet
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    # bcmdhd PCIe RPM (D3) skips RX ring buffers on resume -> RX throughput
    # collapses to ~3-5MB/s and rate adaptation sticks at low MCS. Round 60:
    # the one-shot exec raced with wlan0 readiness (driver probes late) and
    # reconnects/driver reload reset idletime to 11 again. Watcher re-issues
    # PCIE_RPM_DISABLE every 15s. Measured: downlink 3.1 -> 6.2 MB/s, tx
    # bitrate 51.5 -> 137.5 Mbps.
    start wifi_pm_fix
    exec - root root -- /system/bin/cmd overlay enable com.android.internal.systemui.navbar.gestural
    # NXP NFC HAL is oneshot+disabled with no interface attr => no lazy-start;
    # kick it at boot so NfcService can bind.
    start nfc_hal_service
    write /dev/kmsg "B1Q: gestural overlay re-enabled + nfc kicked\n"
